{
  "name": "cci-discipleship-study",
  "version": "1.0.0",
  "private": true,
  "description": "Offline CCI discipleship study app for web, iOS and Android",
  "scripts": {
    "build:bridge": "esbuild js/native-bridge.mjs --bundle --minify --platform=browser --format=iife --outfile=js/native-bridge.bundle.js",
    "build:web": "node scripts/build.js",
    "build": "npm run build:bridge && npm run build:web",
    "sync": "npm run build && cap sync",
    "sync:android": "npm run build && cap sync android",
    "sync:ios": "npm run build && cap sync ios",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "test": "node --test",
    "dev": "npm run build:bridge && python3 -m http.server 8000"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.4.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.4.3",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "esbuild": "0.25.12"
  }
}
